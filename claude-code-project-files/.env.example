# Copy to .env and fill in for your local machine. Never commit .env.
#
# NOTE (found during Phase 0 verification): MariaDB's default `root` account
# uses unix_socket auth and cannot log in over TCP even with a blank password
# — you'll get "Access denied for user 'root'@'localhost'" from PDO. Don't
# point the app at root anyway (bad practice); create a dedicated app user:
#   CREATE USER 'boardinghouse_app'@'127.0.0.1' IDENTIFIED BY 'your_password';
#   GRANT ALL PRIVILEGES ON rjm_boardinghouse.* TO 'boardinghouse_app'@'127.0.0.1';
#   FLUSH PRIVILEGES;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rjm_boardinghouse
DB_USER=boardinghouse_app
DB_PASS=

SCORING_SERVICE_URL=http://127.0.0.1:5000
